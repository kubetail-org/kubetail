# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# dependencies
/apps/web/node_modules
/apps/web/.pnp
/apps/web/.pnp.js

# dev
/apps/web/*.local

# testing
/apps/web/coverage

# build
/bin
/apps/web/dist
/apps/web/dist-ssr

# build artifacts
/dashboard/website/*
!/dashboard/website/
!/dashboard/website/.gitkeep

# pnpm
.pnpm-store

# vite
.vite

# rust
*.rs.bk
*.dll
*.so
*.dylib
*.rmeta
/cluster/agent/*/target
/cluster/agent/target
/target

# sandbox (scripts/sandbox-dev-setup.sh)
/.sandbox-linux

# tilt (custom)
.tilt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agents. Ignore the directory's contents rather than the directory itself, so
# the shared team config below can be re-included — a negation cannot resurrect
# a file whose parent directory is excluded. Personal settings
# (settings.local.json), worktrees, lock files and personal skills stay ignored;
# each shared skill is re-included by name.
CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/release-cli/
!.claude/skills/release-cluster/
!.claude/skills/release-notes/
!.claude/skills/release-version/

# e2e
/e2e/.venv
**/__pycache__
**/.pytest_cache

# Misc
/apps/web/stats.html
.worktrees
.sbx
