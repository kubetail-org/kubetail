# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# dependencies
/dashboard-ui/node_modules
/dashboard-ui/.pnp
/dashboard-ui/.pnp.js

# dev
/dashboard-ui/*.local

# testing
/dashboard-ui/coverage

# build
/bin
/dashboard-ui/dist
/dashboard-ui/dist-ssr

# build artifacts
/modules/dashboard/website/*
!/modules/dashboard/website/
!/modules/dashboard/website/.gitkeep

# pnpm
.pnpm-store

# vite
.vite

# rust
*.rs.bk
*.dll
*.so
*.dylib
*.rmeta
/crates/*/target
/crates/target
/target

# sandbox (scripts/sandbox-dev-setup.sh)
/.sandbox-linux

# tilt (custom)
.tilt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agents. Ignore the directory's contents rather than the directory itself, so
# the shared team config below can be re-included — a negation cannot resurrect
# a file whose parent directory is excluded. Personal settings
# (settings.local.json), worktrees, lock files and personal skills stay ignored;
# each shared skill is re-included by name.
CLAUDE.local.md
.claude/*
!.claude/settings.json

# e2e
/e2e/.venv
**/__pycache__
**/.pytest_cache

# Misc
/dashboard-ui/stats.html
.worktrees
.sbx
