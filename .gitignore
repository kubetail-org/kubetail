# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# dependencies
/apps/web/node_modules
/apps/web/.pnp
/apps/web/.pnp.js

# dev
/apps/web/*.local

# testing
/apps/web/coverage

# build
/bin
/apps/web/dist
/apps/web/dist-ssr

# build artifacts
/dashboard/website/*
!/dashboard/website/
!/dashboard/website/.gitkeep

# pnpm
.pnpm-store

# vite
.vite

# rust
*.rs.bk
*.dll
*.so
*.dylib
*.rmeta
/cluster/agent/*/target
/cluster/agent/target
/target

# sandbox (scripts/sandbox-dev-setup.sh)
/.sandbox-linux

# tilt (custom)
.tilt

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agents. Ignore the directory's contents rather than the directory itself, so
# the shared team config below can be re-included — a negation cannot resurrect
# a file whose parent directory is excluded. Personal settings
# (settings.local.json), worktrees, lock files and personal skills stay ignored;
# each shared skill is re-included by name.
CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/release-cli/
!.claude/skills/release-cluster/
!.claude/skills/release-desktop/
!.claude/skills/release-notes/
!.claude/skills/release-version/

# desktop
/apps/desktop/node_modules
/apps/desktop/dist
/apps/desktop/dist-ssr
/apps/desktop/*.local
/apps/desktop/coverage
/apps/desktop/sidecar/coverage.out
/apps/desktop/src-tauri/target
# The dev app's logs; two source folders share the name.
/apps/desktop/**/logs
!/apps/desktop/sidecar/internal/services/logs/
!/apps/desktop/src/components/logs/
# The outputs of make build-desktop-sidecar, build-desktop-bwrap,
# build-desktop-pasta and build-desktop-embedded-sources.
/apps/desktop/src-tauri/binaries/
/apps/desktop/src-tauri/linux/bwrap
/apps/desktop/src-tauri/linux/bubblewrap-*.tar.xz
/apps/desktop/src-tauri/linux/pasta
/apps/desktop/src-tauri/linux/passt-*.tar.xz
/apps/desktop/src-tauri/linux/embedded-sources.tar.gz

# e2e
/e2e/.venv
**/__pycache__
**/.pytest_cache

# Misc
/apps/web/stats.html
.worktrees
.sbx
