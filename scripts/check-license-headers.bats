#!/usr/bin/env bats

setup() {
  repo="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$repo/scripts"
  cp "$(dirname "$BATS_TEST_FILENAME")/check-license-headers.sh" "$repo/scripts/"
  git -C "$repo" init -q
  # A file the check passes. A Windows checkout may end its lines in CRLF.
  header="$(head -n 13 "$BATS_TEST_DIRNAME/stress.go" | tr -d '\r')"
}

# write <path> <first line>: a file in the repo opening with that line, then code.
write() {
  mkdir -p "$(dirname "$repo/$1")"
  printf '%s\n\npackage a\n' "$2" >"$repo/$1"
}

check() {
  run sh "$repo/scripts/check-license-headers.sh" "$@"
}

@test "files with the header pass" {
  write cli/a/a.go "$header"
  write cluster/agent/a/src/a.rs "$header"
  write apps/web/src/a.tsx "$header"
  check
  [ "$status" -eq 0 ]
}

@test "a header with CRLF line endings passes" {
  mkdir -p "$repo/cli/a"
  printf '%s\n\npackage a\n' "$header" | awk '{ printf "%s\r\n", $0 }' >"$repo/cli/a/a.go"
  check
  [ "$status" -eq 0 ]
}

@test "a file without the header fails" {
  write cli/a/a.go "$header"
  write cli/a/b.go 'package a'
  check
  [ "$status" -eq 1 ]
  [[ "$output" == *"cli/a/b.go"* ]]
  [[ "$output" != *"cli/a/a.go"* ]]
}

@test "a personal copyright line fails" {
  write cluster/agent/a/src/a.rs "${header/The Kubetail Authors/Jane Doe}"
  check
  [ "$status" -eq 1 ]
  [[ "$output" == *"cluster/agent/a/src/a.rs"* ]]
}

@test "a header below the first line fails" {
  write apps/web/src/a.ts "import x from 'x';
$header"
  check
  [ "$status" -eq 1 ]
}

@test "generated code is left out" {
  write cli/a/graph/generated.go '// Code generated by gqlgen, DO NOT EDIT.'
  write cli/a/graph/model/models_gen.go '// Code generated by gqlgen, DO NOT EDIT.'
  write cli/a/graph/schema.resolvers.go 'package graph'
  write apps/web/src/__generated__/gql.ts '/* eslint-disable */'
  check
  [ "$status" -eq 0 ]
}

@test "a directory argument checks that directory alone" {
  write cli/a/a.go 'package a'
  write cluster/agent/a/src/a.rs "$header"
  check cluster/agent
  [ "$status" -eq 0 ]
  check cli
  [ "$status" -eq 1 ]
}
