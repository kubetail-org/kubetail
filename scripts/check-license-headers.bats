#!/usr/bin/env bats

setup() {
  repo="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$repo/scripts"
  cp "$(dirname "$BATS_TEST_FILENAME")/check-license-headers.sh" "$repo/scripts/"
  git -C "$repo" init -q
  # A file the check passes.
  header="$(head -n 13 "$BATS_TEST_DIRNAME/stress.go")"
}

# write <path> <first line>: a file in the repo opening with that line, then code.
write() {
  mkdir -p "$(dirname "$repo/$1")"
  printf '%s\n\npackage a\n' "$2" >"$repo/$1"
}

check() {
  run sh "$repo/scripts/check-license-headers.sh" "$@"
}

@test "files with the header pass" {
  write modules/a/a.go "$header"
  write crates/a/src/a.rs "$header"
  write dashboard-ui/src/a.tsx "$header"
  check
  [ "$status" -eq 0 ]
}

@test "a file without the header fails" {
  write modules/a/a.go "$header"
  write modules/a/b.go 'package a'
  check
  [ "$status" -eq 1 ]
  [[ "$output" == *"modules/a/b.go"* ]]
  [[ "$output" != *"modules/a/a.go"* ]]
}

@test "a personal copyright line fails" {
  write crates/a/src/a.rs "${header/The Kubetail Authors/Jane Doe}"
  check
  [ "$status" -eq 1 ]
  [[ "$output" == *"crates/a/src/a.rs"* ]]
}

@test "a header below the first line fails" {
  write dashboard-ui/src/a.ts "import x from 'x';
$header"
  check
  [ "$status" -eq 1 ]
}

@test "generated code is left out" {
  write modules/a/graph/generated.go '// Code generated by gqlgen, DO NOT EDIT.'
  write modules/a/graph/model/models_gen.go '// Code generated by gqlgen, DO NOT EDIT.'
  write modules/a/graph/schema.resolvers.go 'package graph'
  write dashboard-ui/src/__generated__/gql.ts '/* eslint-disable */'
  check
  [ "$status" -eq 0 ]
}

@test "a directory argument checks that directory alone" {
  write modules/a/a.go 'package a'
  write crates/a/src/a.rs "$header"
  check crates
  [ "$status" -eq 0 ]
  check modules
  [ "$status" -eq 1 ]
}
