{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/sandbox-dev-setup.sh\" 2>&1 || true",
            "timeout": 120,
            "statusMessage": "Checking sandbox build isolation..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/writing-standards-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
